+        uint64_t mask = UINT64_C(0xffffffff) << (32 * category);
+        packed = (packed & ~mask) | ((uint64_t)next << (32 * category));
+        __atomic_store_n(shared, packed, __ATOMIC_RELEASE);
+    }
+    IOLockUnlock(sweet_surface_lock);
+    return ret;
 }
 
