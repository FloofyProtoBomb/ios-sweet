-IOSurfaceRootUserClient::trapUseCount(__unused void *id, __unused void *category,
+IOSurfaceRootUserClient::changeUseCount(uint32_t id, uint32_t category, bool add)
+{
+    if (category >= 2) {
+        return kIOReturnBadArgument;
+    }
+    IOLockLock(fLock);
+    SweetSurfaceRef *ref = findRef(id, NULL);
+    IOReturn ret = kIOReturnNotFound;
+    if (ref != NULL) {
+        uint32_t current = ref->useCount[category];
+        if ((add && current == UINT32_MAX) || (!add && current == 0)) {
+            ret = add ? kIOReturnNoResources : kIOReturnBadArgument;
+        } else {
+            ret = sweet_surface_use_change(ref->surface, category, 1, add);
+            if (ret == kIOReturnSuccess) {
+                ref->useCount[category] = add ? current + 1 : current - 1;
+            }
+        }
+    }
+    IOLockUnlock(fLock);
+    return ret;
+}
