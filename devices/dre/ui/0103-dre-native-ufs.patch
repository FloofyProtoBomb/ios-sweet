+#if defined(ARM64_BOARD_CONFIG_DRE)
+extern "C" int dre_ufs_prepare_device(dev_t *device);
+extern "C" int dre_ufs_get_handoff(uint64_t words[8]);
+extern "C" int
+dre_ufs_get_handoff(uint64_t words[8])
+{
+    IORegistryEntry *entry = IORegistryEntry::fromPath("/dre-ufs", gIODTPlane);
+    if (!entry) return 0;
+    OSData *compatible = OSDynamicCast(OSData, entry->getProperty("compatible"));
+    OSData *handoff = OSDynamicCast(OSData, entry->getProperty("dre,handoff"));
+    const char expected[] = "oneplus,dre-ufs";
+    int valid = compatible && compatible->getLength() == sizeof(expected) &&
+        !memcmp(compatible->getBytesNoCopy(), expected, sizeof(expected)) &&
+        handoff && handoff->getLength() == 64;
+    if (valid) memcpy(words, handoff->getBytesNoCopy(), 64);
+    entry->release();
+    return valid;
+}
+#endif
