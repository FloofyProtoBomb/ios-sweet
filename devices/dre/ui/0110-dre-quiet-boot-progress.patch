+#if defined(ARM64_BOARD_CONFIG_DRE)
+void
+dre_boot_checkpoint(enum dre_boot_stage stage)
+{
+	static const char *const messages[DRE_BOOT_STAGE_COUNT] = {
+		[DRE_BOOT_FRAMEBUFFER_READY] = "DRE BOOT: framebuffer ready\n",
+		[DRE_BOOT_ROOT_MOUNTED] = "DRE BOOT: root mounted\n",
+		[DRE_BOOT_PID1_LOADED] = "DRE BOOT: PID 1 loaded\n",
+		[DRE_BOOT_BACKBOARD_CONNECTED] = "DRE BOOT: backboardd opened display\n",
+		[DRE_BOOT_SWAP_QUEUED] = "DRE BOOT: swap queued\n",
+		[DRE_BOOT_SWAP_DEQUEUED] = "DRE BOOT: display timer dequeued swap\n",
+		[DRE_BOOT_SURFACE_MISSING] = "DRE BOOT: swap surface unavailable\n",
+		[DRE_BOOT_SURFACE_INVALID] = "DRE BOOT: swap surface layout refused\n",
+		[DRE_BOOT_MAP_FAILED] = "DRE BOOT: swap surface mapping failed\n",
+		[DRE_BOOT_COPY_BEGIN] = "DRE BOOT: copying first frame\n",
+	};
+	static uint32_t seen;
+	extern int disableConsoleOutput;
+
+	if (!dre_quiet_boot || !dre_boot_progress_enabled ||
+	    (unsigned int)stage >= DRE_BOOT_STAGE_COUNT || !is_console_initialized() ||
+	    get_preemption_level() != 0 || !ml_get_interrupts_enabled() || panic_active()) {
+		return;
+	}
+	uint32_t bit = 1u << stage;
+	uint32_t blocked = (1u << DRE_BOOT_COPY_BEGIN) | bit;
+	if (os_atomic_load(&seen, relaxed) & blocked) {
+		return;
+	}
+	/* The console drain and these short lines share one output lock. The
+	 * final checkpoint closes this path before the compositor writes pixels.
+	 */
+	lck_mtx_lock(&console_ring.flush_lock);
+	uint32_t snapshot = os_atomic_load(&seen, relaxed);
+	if (!(snapshot & blocked) && !panic_active()) {
+		if (stage == DRE_BOOT_COPY_BEGIN || (!disableConsoleOutput && !sweet_console_muted)) {
+			os_atomic_store(&seen, snapshot | bit, relaxed);
+		}
+		if (!disableConsoleOutput && !sweet_console_muted) {
+			for (const char *c = messages[stage]; *c; c++) {
+				_cnputc(*c, true);
+			}
+		}
+	}
+	lck_mtx_unlock(&console_ring.flush_lock);
+}
+#endif
 
